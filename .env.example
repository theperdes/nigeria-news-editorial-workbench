# Optional live AI stages only. The offline demo does not read this file.
# Fill your own key and a model available in your account. No key is bundled.
LLM_PREFILTER_PROVIDER=deepseek
LLM_DIGEST_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PREFILTER_MODEL=
DEEPSEEK_DIGEST_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PREFILTER_MODEL=
LLM_PREFILTER_BATCH_SIZE=10
LLM_PREFILTER_MAX_OUTPUT_TOKENS=6000
LLM_PREFILTER_MIN_PRIORITY=medium
LLM_DIGEST_MAX_OUTPUT_TOKENS=8000
MAX_ARTICLE_TEXT_CHARS=9000
# Optional local UI session signing secret; generated per process if unset.
NEWS_UI_STORAGE_SECRET=

